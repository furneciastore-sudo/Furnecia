# Copy this file to .env and fill in your own values before running the app.

# SQLite database file (default is fine for local use / a single small VPS).
DATABASE_URL="file:./dev.db"

# The password used to sign in to the dashboard. Change this before deploying.
ADMIN_PASSWORD="furnecia123"

# Random long string used to sign login sessions. Change this to any random
# text before deploying (e.g. run: openssl rand -hex 32).
AUTH_SECRET="change-this-to-a-long-random-string"

# Optional: set this to enable the token-protected /api/public/orders CSV
# feed used for the Google Sheets sync described in the README. Leave blank
# to keep that endpoint disabled.
EXPORT_API_TOKEN=""
