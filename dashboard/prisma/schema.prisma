// Furnecia Order Management Dashboard — data model
// Mirrors the "Google Sheets" structure described in the project brief
// (Orders / Vendors / Products / Settings / Payments / Reminders) so the
// same shape can be exported to / synced with Google Sheets later.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Vendor {
  id            Int      @id @default(autoincrement())
  name          String   @unique
  contactPerson String?
  phone         String?
  whatsapp      String?
  email         String?
  address       String?
  products      String? // free-text list of products supplied
  defaultLeadTimeDays Int? // used by the Delivery Date Checker when a product has no override
  status        String   @default("Active") // Active | Inactive
  isDemo        Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  orders          Order[]
  defaultProducts Product[]
}

model Product {
  id                   Int      @id @default(autoincrement())
  name                 String
  code                 String?  @unique
  category             String?
  defaultPrice         Float    @default(0)
  defaultVendorId      Int?
  defaultVendor        Vendor?  @relation(fields: [defaultVendorId], references: [id])
  defaultVendorCost    Float    @default(0)
  defaultFittingCharge Float?
  defaultLeadTimeDays  Int? // overrides the vendor's lead time for the Delivery Date Checker
  status               String   @default("Active") // Active | Inactive
  isDemo               Boolean  @default(false)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
}

model Setting {
  key   String @id
  value String
}

model Order {
  id        Int    @id @default(autoincrement())
  orderNo   String @unique // e.g. FRN-2026-0001

  // Customer information
  customerName String
  contact      String
  whatsapp     String?
  address      String
  postcode     String?
  city         String?

  // Product information
  productName String
  productCode String?
  colour      String?
  quantity    Int    @default(1)
  productPrice Float @default(0)

  // Vendor
  vendorId Int?
  vendor   Vendor? @relation(fields: [vendorId], references: [id])

  // Dates
  bookingDate          DateTime @default(now())
  deliveryDateExpected DateTime?
  deliveryDateActual   DateTime?

  // Floor / lift / fitting
  floor           String  @default("Ground Floor")
  liftAvailable   Boolean @default(false)
  floorCharge     Float   @default(0)
  fittingRequired Boolean @default(false)
  fittingCharge   Float   @default(0)

  // Totals (customer side)
  additionalCharge Float @default(0)
  discount         Float @default(0)
  customerTotal    Float @default(0)

  // Customer payment
  amountPaid      Float     @default(0)
  customerPending Float     @default(0)
  paymentStatus   String    @default("Not Paid")
  paymentDate     DateTime?
  paymentMethod   String?
  paymentNotes    String?

  // Vendor payment / cost
  vendorProductCost   Float     @default(0)
  vendorDeliveryCost  Float     @default(0)
  vendorOtherCost     Float     @default(0)
  vendorTotalCost     Float     @default(0)
  vendorPaid          Float     @default(0)
  vendorPending       Float     @default(0)
  vendorPaymentStatus String    @default("Not Paid")
  vendorPaymentDate   DateTime?

  // Commission / profit
  commissionType    String @default("profit") // profit | fixed | percentage
  commissionValue   Float  @default(0)
  commissionAmount  Float  @default(0)
  otherBusinessCost Float  @default(0)
  grossProfit       Float  @default(0)
  netProfit         Float  @default(0)

  // Delivery / status
  deliveryStatus String @default("New Order")
  notes          String?

  isArchived Boolean @default(false)
  isDemo     Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  payments  Payment[]
  reminders Reminder[]

  @@index([deliveryDateExpected])
  @@index([bookingDate])
  @@index([deliveryStatus])
  @@index([paymentStatus])
}

model Payment {
  id       Int      @id @default(autoincrement())
  orderId  Int
  order    Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  type     String // customer | vendor
  amount   Float
  date     DateTime @default(now())
  method   String?
  notes    String?
  createdAt DateTime @default(now())
}

model Reminder {
  id           Int       @id @default(autoincrement())
  orderId      Int?
  order        Order?    @relation(fields: [orderId], references: [id], onDelete: SetNull)
  customerName String?
  type         String // Customer Follow-up | Vendor Follow-up | Delivery Confirmation | Payment Follow-up | Vendor Payment Follow-up | Commission Follow-up
  date         DateTime
  time         String?
  notes        String?
  status       String    @default("Pending") // Pending | Completed
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([date])
  @@index([status])
}
